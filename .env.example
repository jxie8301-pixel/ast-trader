# AST-Trader 环境变量示例
# 用法：复制为 .env（已在 .gitignore 中，不会入库），按需填写。
# ★ 真实环境变量优先级更高 —— .env 只做 setdefault，不会覆盖 CI / 生产注入。

# ─── 通达信行情主站（7709）候选节点 ───
# 逗号 / 分号 / 空白分隔。端口可省略（自动补 7709）。
# 未设置时依次回落：tdx_servers.json → 历史 DEFAULT_TDX_HOSTS → eltdx 内置 43 台池。
# ★ 本包绝不从线上拉取主机名单（供应链风险），配置只来自本地。
# AST_TDX_HOSTS=116.205.183.150:7709,111.230.186.52:7709

# ─── AI 语义判断层 ───
# 是否启用。默认 0（关闭）：保证测试确定性与无网时主流程可用。
# 也可在命令行用 `python cli.py analyze <code> --ai` 临时开启，无需改这里。
AST_AI_ENABLED=0

# API Key（OpenAI 兼容端点）。★ 严禁硬编码进任何源码文件。
AST_AI_API_KEY=

# 端点与模型
AST_AI_API_BASE=https://token.vip.cpolar.cn/v1
AST_AI_MODEL=deepseek-v4.1-flash
